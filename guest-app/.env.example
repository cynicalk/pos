# PostHog analytics (optional).
#
# Leave BOTH unset to keep events in the local buffer + console only
# (see lib/analytics.ts). Set the key to initialise posthog-js
# (lib/posthog-sink.ts) with autocapture + session replay, and auto-forward
# every tracked event — no other code changes needed.
#
# Session replay must ALSO be enabled in your PostHog project settings.
#
# Copy this file to `.env.local` and fill in your project values.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cooklyt operator backend (the ops app). The guest app fetches its live menu,
# affinities, and submits orders/tables here.
NEXT_PUBLIC_COOKLYT_API=http://localhost:3000

# Which outlet this guest surface belongs to (bake it into the QR/deployment).
# When unset the backend falls back to its first outlet, which is only correct
# for a single-outlet deployment — set it explicitly for a real deploy.
NEXT_PUBLIC_COOKLYT_OUTLET=

# Error tracking (optional, provider-agnostic — see lib/observability.ts).
# Errors always print as structured JSON; when a webhook is set the same payload
# is POSTed there (Sentry generic webhook / Slack / any JSON collector).
# Server-side errors → ERROR_WEBHOOK_URL; browser errors → NEXT_PUBLIC_ one.
ERROR_WEBHOOK_URL=
NEXT_PUBLIC_ERROR_WEBHOOK_URL=
