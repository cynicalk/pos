# Backend API URL (used for the Google OAuth redirect link)
VITE_API_URL=http://localhost:3000

# Set this to show the "Sign in with Google" button (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Where the guest dine-in app (guest-app/) is served, for the sidebar's
# "Dine-in App" link. Defaults to the current host on port 3001 when unset.
VITE_GUEST_URL=
